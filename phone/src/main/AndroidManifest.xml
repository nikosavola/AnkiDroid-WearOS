<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permission required to access AnkiDroid ContentProvider -->
    <uses-permission android:name="com.ichi2.anki.permission.READ_WRITE_DATABASE" />

    <!-- Foreground service + notification for background sync to the watch -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <queries>
        <package android:name="com.ichi2.anki" />
    </queries>

    <application
        android:name=".AnkiPhoneApp"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="AnkiDroid WearOS Phone"
        android:supportsRtl="true"
        android:theme="@style/Theme.Material3.DayNight.NoActionBar">
        
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Foreground service that pushes decks to the watch with a progress notification -->
        <service
            android:name=".SyncService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Passively runs in background to receive reviews and deck requests from the watch -->
        <service
            android:name=".WearSyncService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <!-- Answers arrive as data items; deck requests arrive as messages -->
                <data android:scheme="wear" android:host="*" android:pathPrefix="/answers" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/request_deck" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/request_decks" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/request_new" />
            </intent-filter>
        </service>
        
        <!-- AppFunctions (Android 16+): lets an assistant list decks and manage watch syncing. The
             class is generated by KSP from BasePhoneAppFunctionService. -->
        <service
            android:name=".appfunctions.PhoneAppFunctionService"
            android:enabled="@bool/enablePlatformAppFunctionService"
            android:exported="true"
            android:permission="android.permission.BIND_APP_FUNCTION_SERVICE"
            tools:targetApi="36">
            <property
                android:name="android.app.appfunctions.schema"
                android:value="app_functions_schema.xsd" />
            <property
                android:name="android.app.appfunctions.v2"
                android:value="phone_app_functions.xml" />
            <intent-filter>
                <action android:name="android.app.appfunctions.AppFunctionService" />
            </intent-filter>
        </service>
        <property
            android:name="android.app.appfunctions.app_metadata"
            android:resource="@xml/app_functions_metadata" />

    </application>

</manifest>
