<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permission required to access AnkiDroid ContentProvider -->
    <uses-permission android:name="com.ichi2.anki.permission.READ_WRITE_DATABASE" />

    <!-- Foreground service + notification for background sync to the watch -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <queries>
        <package android:name="com.ichi2.anki" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="AnkiDroid WearOS Phone"
        android:supportsRtl="true"
        android:theme="@style/Theme.Material3.DayNight.NoActionBar">
        
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Foreground service that pushes decks to the watch with a progress notification -->
        <service
            android:name=".SyncService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Passively runs in background to receive reviews and deck requests from the watch -->
        <service
            android:name=".WearSyncService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <!-- Answers arrive as data items; deck requests arrive as messages -->
                <data android:scheme="wear" android:host="*" android:pathPrefix="/answers" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/request_deck" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/request_decks" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/request_new" />
            </intent-filter>
        </service>
        
    </application>

</manifest>
