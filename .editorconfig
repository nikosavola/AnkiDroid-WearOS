root = true

# What reads this file:
#   - ktlint (Kotlin): fully driven by .editorconfig — the standard-rule toggles below live here.
#   - editors / IDEs: indentation, line length, final newline.
# What does NOT (their config stays put, by design):
#   - ktfmt: the sole formatting authority; its style (googleStyle) is set in build.gradle.kts. The
#     ncorti plugin (0.26) doesn't consume .editorconfig, so indent_size/max_line_length below just
#     MIRROR googleStyle (2-space, 100 cols) to keep editors agreeing with the formatter.
#   - detekt: core rules are YAML only (config/detekt/detekt.yml).

[*.{kt,kts}]
indent_size = 2
max_line_length = 100
insert_final_newline = true
# ktfmt owns formatting, so ktlint's formatting/layout rules are disabled to avoid fighting it.
ktlint_standard_indent = disabled
ktlint_standard_max-line-length = disabled
ktlint_standard_wrapping = disabled
ktlint_standard_argument-list-wrapping = disabled
ktlint_standard_parameter-list-wrapping = disabled
# New layout rules in ktlint 14.x that ktfmt already owns (code is ktfmt-clean); disabled so the two
# don't fight, same as the wrapping family above.
ktlint_standard_multiline-expression-wrapping = disabled
ktlint_standard_chain-method-continuation = disabled
ktlint_standard_class-signature = disabled
ktlint_standard_function-expression-body = disabled
ktlint_standard_function-literal = disabled
ktlint_standard_function-signature = disabled
ktlint_standard_import-ordering = disabled
ktlint_standard_string-template-indent = disabled
ktlint_standard_trailing-comma-on-call-site = disabled
ktlint_standard_trailing-comma-on-declaration-site = disabled
ktlint_standard_no-wildcard-imports = disabled
ktlint_standard_function-naming = disabled
ktlint_standard_spacing-between-declarations-with-comments = disabled

# Editor guidance for other file types (their own tools own enforcement: rustfmt via
# core/.rustfmt.toml, yamlfmt via .github/.yamlfmt.yaml).
[*.rs]
indent_size = 4
max_line_length = 100
insert_final_newline = true

[*.{yml,yaml,toml}]
indent_size = 2
insert_final_newline = true

[bindings/**]
ktlint_disabled = true

[wear/src/main/jniLibs/**]
ktlint_disabled = true

[phone/src/main/jniLibs/**]
ktlint_disabled = true
